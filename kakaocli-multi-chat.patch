@@ -0,0 +1,35 @@
+import Foundation
+import Testing
+@testable import KakaoCore
+
+struct BackgroundWindowSelectionTests {
+    @Test func selectsTargetAmongOtherChatAndNotificationWindows() throws {
+        #expect(try BackgroundWindowSelection.index(
+            titles: ["다른 방", "알림", "경 민", "카카오톡"], chatName: "경민") == 2)
+        #expect(try BackgroundWindowSelection.index(
+            titles: ["경민", "다른 방"], chatName: "경민") == 0)
+    }
+
+    @Test func rejectsMissingAndSubstringOnlyTargets() {
+        for titles in [[], ["경민 회사", "다른 방"]] as [[String]] {
+            #expect(throws: (any Error).self) {
+                try BackgroundWindowSelection.index(titles: titles, chatName: "경민")
+            }
+        }
+    }
+
+    @Test func rejectsAmbiguousNamesAfterWhitespaceNormalization() {
+        #expect(throws: (any Error).self) {
+            try BackgroundWindowSelection.index(
+                titles: ["경 민", "다른 방", "경민"], chatName: "경민")
+        }
+    }
+
+    @Test func normalizesUnicodeAndRejectsBlankTarget() throws {
+        #expect(try BackgroundWindowSelection.index(
+            titles: ["경민".decomposedStringWithCanonicalMapping], chatName: "경민") == 0)
+        #expect(throws: (any Error).self) {
+            try BackgroundWindowSelection.index(titles: [""], chatName: " ")
+        }
+    }
+}
