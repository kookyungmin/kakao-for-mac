@@ -0,0 +1,22 @@
+import Foundation
+
+/// Selection is independent of window ordering and the app's current main window.
+enum BackgroundWindowSelection {
+    static func index(titles: [String], chatName: String) throws -> Int {
+        func key(_ name: String) -> String {
+            name.filter { !$0.isWhitespace }.precomposedStringWithCanonicalMapping
+        }
+        let target = key(chatName)
+        guard !target.isEmpty else {
+            throw AutomationError.sendFailed("background_window_required")
+        }
+        let matches = titles.indices.filter { key(titles[$0]) == target }
+        guard !matches.isEmpty else {
+            throw AutomationError.sendFailed("background_window_required")
+        }
+        guard matches.count == 1 else {
+            throw AutomationError.sendFailed("background_duplicate_target_windows")
+        }
+        return matches[0]
+    }
+}
