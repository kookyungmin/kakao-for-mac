--- a/Sources/KakaoCore/Automation/KakaoAutomator.swift
+++ b/Sources/KakaoCore/Automation/KakaoAutomator.swift
@@ -8,8 +8,110 @@ public final class KakaoAutomator {
 
     public init() {}
 
+    /// Never activates, opens, raises, clicks, or changes the selected chat.
+    /// Refuses to act unless the sole existing input window is the named main window.
+    private func backgroundTarget(to chatName: String) throws -> (pid_t, AXUIElement, AXUIElement) {
+        guard AXIsProcessTrusted() else {
+            throw AutomationError.sendFailed("accessibility_permission_denied")
+        }
+        guard let process = NSRunningApplication.runningApplications(withBundleIdentifier: Self.bundleId).first else {
+            throw AutomationError.sendFailed("background_app_not_running")
+        }
+        let app = AXUIElementCreateApplication(process.processIdentifier)
+        let candidates = AXHelpers.windows(app).compactMap { window -> (AXUIElement, AXUIElement)? in
+            guard AXHelpers.role(window) == "AXWindow", let input = findInputField(in: window) else { return nil }
+            return (window, input)
+        }
+        guard !candidates.isEmpty else {
+            throw AutomationError.sendFailed("background_window_required")
+        }
+        guard candidates.count == 1 else {
+            throw AutomationError.sendFailed("background_multiple_windows")
+        }
+        let (window, input) = candidates[0]
+        let compact: (String) -> String = { $0.filter { !$0.isWhitespace }.precomposedStringWithCanonicalMapping }
+        guard compact(AXHelpers.title(window) ?? "") == compact(chatName) else {
+            throw AutomationError.sendFailed("background_target_mismatch")
+        }
+        guard AXHelpers.boolAttribute(window, kAXMinimizedAttribute as String) != true else {
+            throw AutomationError.sendFailed("background_window_minimized")
+        }
+        guard AXHelpers.boolAttribute(window, kAXMainAttribute as String) == true else {
+            throw AutomationError.sendFailed("background_target_not_main")
+        }
+        guard (AXHelpers.value(input) ?? "").isEmpty else {
+            throw AutomationError.sendFailed("background_existing_draft")
+        }
+        return (process.processIdentifier, window, input)
+    }
+
+    public func checkBackground(to chatName: String) throws {
+        _ = try backgroundTarget(to: chatName)
+    }
+
+    private func inputIsFocused(_ input: AXUIElement, pid: pid_t) -> Bool {
+        let app = AXUIElementCreateApplication(pid)
+        var focused: AnyObject?
+        return AXUIElementCopyAttributeValue(app, kAXFocusedUIElementAttribute as CFString, &focused) == .success
+            && focused.map { CFEqual($0, input) } == true
+    }
+
+    private func focusBackgroundInput(_ input: AXUIElement, pid: pid_t) throws {
+        if inputIsFocused(input, pid: pid) { return }
+        // Change the responder inside the existing app without clicks, raises,
+        // application activation, or global keyboard events.
+        _ = AXHelpers.focus(input)
+        if !inputIsFocused(input, pid: pid) {
+            let app = AXUIElementCreateApplication(pid)
+            _ = AXUIElementSetAttributeValue(app, kAXFocusedUIElementAttribute as CFString, input)
+        }
+        for _ in 0..<5 {
+            if inputIsFocused(input, pid: pid) { return }
+            Thread.sleep(forTimeInterval: 0.05)
+        }
+        throw AutomationError.sendFailed("background_focus_failed")
+    }
+
+    /// Sets only the existing input's AX focus. Does not type or send anything.
+    public func prepareBackgroundInput(to chatName: String) throws {
+        let (pid, _, input) = try backgroundTarget(to: chatName)
+        try focusBackgroundInput(input, pid: pid)
+    }
+
+    public func sendBackground(to chatName: String, message: String) throws {
+        let (pid, window, input) = try backgroundTarget(to: chatName)
+        try focusBackgroundInput(input, pid: pid)
+        let (_, checkedWindow, checkedInput) = try backgroundTarget(to: chatName)
+        guard CFEqual(window, checkedWindow), CFEqual(input, checkedInput) else {
+            throw AutomationError.sendFailed("background_target_changed")
+        }
+        guard AXHelpers.setValue(input, message), AXHelpers.value(input) == message else {
+            throw AutomationError.sendFailed("background_set_value_failed")
+        }
+        // Recheck the target immediately before dispatch; no global keyboard events.
+        guard AXHelpers.boolAttribute(window, kAXMainAttribute as String) == true,
+              inputIsFocused(input, pid: pid) else {
+            throw AutomationError.sendFailed("background_target_changed")
+        }
+        guard let down = CGEvent(keyboardEventSource: nil, virtualKey: 36, keyDown: true),
+              let up = CGEvent(keyboardEventSource: nil, virtualKey: 36, keyDown: false) else {
+            throw AutomationError.sendFailed("background_event_failed")
+        }
+        down.postToPid(pid)
+        up.postToPid(pid)
+        let deadline = Date().addingTimeInterval(2)
+        while Date() < deadline {
+            Thread.sleep(forTimeInterval: 0.1)
+            if (AXHelpers.value(input) ?? message).isEmpty { return }
+        }
+        throw AutomationError.sendFailed("background_delivery_unconfirmed")
+    }
+
     /// Send a message to a chat by navigating the UI.
-    public func sendMessage(to chatName: String, message: String, selfChat: Bool = false) throws {
