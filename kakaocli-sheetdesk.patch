index 0000000..d776602
--- /dev/null
+++ b/Sources/KakaoCLI/Commands/DiagnosticsCommand.swift
@@ -0,0 +1,59 @@
+import ArgumentParser
+import AppKit
+import ApplicationServices
+import Foundation
+import KakaoCore
+
+/// Read-only diagnostics: no activation, login, window changes, or message values.
+struct DiagnosticsCommand: ParsableCommand {
+    static let configuration = CommandConfiguration(
+        commandName: "diagnostics",
+        abstract: "Check accessibility and window availability without sending or opening anything"
+    )
+
+    @Option(name: .long, help: "Check whether an exact chat name is visible (name is not printed)")
+    var chat: String?
+
+    @Flag(name: .long, help: "Set focus inside an existing verified chat window; never type, send, or activate the app")
+    var prepareInput = false
+
+    func run() throws {
+        guard !prepareInput || chat != nil else {
+            throw ValidationError("--prepare-input requires --chat.")
+        }
+        let running = !NSRunningApplication.runningApplications(withBundleIdentifier: KakaoAutomator.bundleId).isEmpty
+        let trusted = AXIsProcessTrusted()
+        var data: [String: Any] = ["running": running, "accessibility": trusted]
+        if running && trusted, let app = try? AXHelpers.appElement(bundleId: KakaoAutomator.bundleId) {
+            let windows = AXHelpers.windows(app)
+            data["window_count"] = windows.count
+            if let main = windows.first(where: { AXHelpers.identifier($0) == "Main Window" }),
+               let table = AXHelpers.chatListTable(main) {
+                data["chat_list_available"] = true
+                if let chat {
+                    data["exact_room_visible"] = AXHelpers.findChatRow(table, chatName: chat, exact: true) != nil
+                }
+            } else {
+                data["chat_list_available"] = false
+            }
+        }
+        if let chat {
+            do {
+                let automator = KakaoAutomator()
+                try automator.checkBackground(to: chat)
+                if prepareInput {
+                    let before = NSWorkspace.shared.frontmostApplication?.processIdentifier
+                    try automator.prepareBackgroundInput(to: chat)
+                    data["input_focus_prepared"] = true
+                    data["frontmost_unchanged"] = before == NSWorkspace.shared.frontmostApplication?.processIdentifier
+                }
+                data["background_ready"] = true
+            } catch {
+                data["background_ready"] = false
+                data["background_reason"] = String(describing: error)
+            }
+        }
+        let json = try JSONSerialization.data(withJSONObject: data, options: [.sortedKeys])
+        print(String(decoding: json, as: UTF8.self))
+    }
+}
