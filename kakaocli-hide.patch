     public static let bundleId = "com.kakao.KakaoTalkMac"
 
     public init() {}
+
+    public func isHidden() -> Bool {
+        guard let process = NSRunningApplication.runningApplications(withBundleIdentifier: Self.bundleId).first,
+              process.isHidden,
+              let windows = CGWindowListCopyWindowInfo([.optionOnScreenOnly, .excludeDesktopElements], kCGNullWindowID) as? [[String: Any]] else {
+            return false
+        }
+        return !windows.contains { ($0[kCGWindowOwnerPID as String] as? NSNumber)?.int32Value == process.processIdentifier }
+    }
+
+    public func hideApplication() throws {
+        guard AXIsProcessTrusted() else {
+            throw AutomationError.sendFailed("accessibility_permission_denied")
+        }
+        guard let process = NSRunningApplication.runningApplications(withBundleIdentifier: Self.bundleId).first else {
+            throw AutomationError.sendFailed("background_app_not_running")
+        }
+        if isHidden() { return }
+        _ = process.hide()
+        for _ in 0..<20 {
+            if isHidden() { return }
+            Thread.sleep(forTimeInterval: 0.05)
+        }
+        throw AutomationError.sendFailed("background_cannot_hide")
+    }
+
+    private func requireHidden() throws {
+        guard isHidden() else {
+            try? hideApplication()
+            throw AutomationError.sendFailed("background_cannot_hide")
+        }
+    }
 
