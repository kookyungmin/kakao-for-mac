+    /// AXWindows can omit a window while KakaoTalk changes its active window.
+    private func chatWindows(_ app: AXUIElement) -> [AXUIElement] {
+        var windows = AXHelpers.windows(app)
+        for name in [kAXMainWindowAttribute, kAXFocusedWindowAttribute] {
+            var value: AnyObject?
+            if AXUIElementCopyAttributeValue(app, name as CFString, &value) == .success,
+               let value, CFGetTypeID(value) == AXUIElementGetTypeID() {
+                let window = value as! AXUIElement
+                if !windows.contains(where: { CFEqual($0, window) }) { windows.append(window) }
+            }
+        }
+        return windows.filter {
+            let role = AXHelpers.role($0)
+            return role == nil || role == "AXWindow"
+        }
+    }
+
+    private func chatWindowTitle(_ window: AXUIElement) -> String {
+        if let title = AXHelpers.title(window), !title.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
+            return title
+        }
+        // Use only the window's explicit title element, never message/sender text.
+        var value: AnyObject?
+        if AXUIElementCopyAttributeValue(window, kAXTitleUIElementAttribute as CFString, &value) == .success,
+           let value, CFGetTypeID(value) == AXUIElementGetTypeID() {
+            let titleElement = value as! AXUIElement
+            return AXHelpers.title(titleElement) ?? AXHelpers.value(titleElement) ?? ""
+        }
+        return ""
+    }
+
+    /// Explicit diagnostic metadata only; never includes messages or input values.
+    public func windowReport() throws -> [[String: Any]] {
+        guard AXIsProcessTrusted() else {
+            throw AutomationError.sendFailed("accessibility_permission_denied")
+        }
+        let app = try AXHelpers.appElement(bundleId: Self.bundleId)
+        return chatWindows(app).map { window in
+            ["title": chatWindowTitle(window),
+             "role": AXHelpers.role(window) ?? "",
+             "identifier": AXHelpers.identifier(window) ?? "",
+             "minimized": AXHelpers.boolAttribute(window, kAXMinimizedAttribute as String) == true,
+             "editable_input": findInputField(in: window) != nil,
+             "send_button": (try? sendButton(in: window)) != nil]
+        }
+    }
