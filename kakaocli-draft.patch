@@ -0,0 +1,26 @@
+import Foundation
+
+/// Restores an overwritten draft only before Return dispatch and only if untouched.
+enum BackgroundDraftTransaction {
+    static func replaceAndDispatch(
+        message: String,
+        read: () -> String?,
+        write: (String) -> Bool,
+        dispatch: () throws -> Void
+    ) throws {
+        guard let previous = read() else {
+            throw AutomationError.sendFailed("background_set_value_failed")
+        }
+        var dispatched = false
+        defer {
+            if !dispatched, read() == message {
+                _ = write(previous)
+            }
+        }
+        guard write(message), read() == message else {
+            throw AutomationError.sendFailed("background_set_value_failed")
+        }
+        try dispatch()
+        dispatched = true
+    }
+}
