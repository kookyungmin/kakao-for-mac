@@ -0,0 +1,13 @@
+import Foundation
+
+/// Exact labels only: never confuse scheduling, attachments, or menu controls with Send.
+enum SendButtonSelection {
+    static func matches(labels: [String], supportsPress: Bool) -> Bool {
+        guard supportsPress else { return false }
+        let accepted: Set<String> = ["전송", "보내기", "send", "sendbutton", "sendmessagebutton"]
+        return labels.contains { label in
+            let key = label.lowercased().filter { !$0.isWhitespace && $0 != "_" && $0 != "-" }
+            return accepted.contains(key)
+        }
+    }
+}
